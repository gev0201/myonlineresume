# Production Environment Variables for cPanel Deployment
# Copy these to cPanel Node.js App Environment Variables section

# Database Configuration (from cPanel PostgreSQL setup)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_database_name_here
DATABASE_USER=your_database_user_here
DATABASE_PASSWORD=your_database_password_here

# SMTP Email Configuration (from cPanel Email Accounts)
SMTP_HOST=mail.myonlineresume.am
SMTP_PORT=465
SMTP_USER=noreply@myonlineresume.am
SMTP_PASS=your_email_password_here

# Application Configuration
NEXT_PUBLIC_BASE_URL=https://myonlineresume.am
NODE_ENV=production
